Q.AGES = {
	kids = { name = "Little Explorers", range = "Ages 6–9", emoji = "🐣" },
	juniors = { name = "Junior Brains", range = "Ages 10–12", emoji = "🚀" },
	teens = { name = "Teen Thinkers", range = "Ages 13–17", emoji = "⚡" },
	adults = { name = "Grown-ups", range = "Ages 18+", emoji = "🎓" },
}
Q.ORDER = { "kids", "juniors", "teens", "adults" }

