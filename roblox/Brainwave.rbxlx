<Item class="ModuleScript" referent="RBX0005"><Properties><string name="Name">BrainwaveQuestions</string><ProtectedString name="Source"><![CDATA[-- Brainwave question bank (generated from the website's questions).
-- Each answer is "Display/alias/alias". c = common (10), u = uncommon (25), r = rare (50).

